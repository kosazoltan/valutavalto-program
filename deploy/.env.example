# Valutavalto ERP — Production Environment Variables
# Masold .env neven es toltsd ki az ertekeket!

# Database
DB_USER=valuta
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (min 256 bit / 32+ karakter)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# Google OAuth (opcionalis — Gmail integracio)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption (AES kulcsok)
ENCRYPTION_KEY=CHANGE_ME
ENCRYPTION_SALT=CHANGE_ME

# SMTP (opcionalis — email kuldes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Error log HMAC
ERRORLOG_HMAC_SECRET=

# JVM beallitasok
JAVA_OPTS=-Xmx512m -Xms256m

# NVD API kulcs a security gate / OWASP dependency-check futtatasahoz
NVD_API_KEY=

# Backup titkositas (opcionalis — GPG symmetric key)
# Ha beallitod, a napi backup AES-256 GPG-vel titkositva lesz
BACKUP_GPG_KEY=

# Domain
DOMAIN=excvaluta.com

# Spring profile (Hetzner systemd: prod — NEM production)
SPRING_PROFILES_ACTIVE=prod

# FK-091: HQ vészkijárat (helyi artifact = sikeres HQ-küldés) — profilfüggetlen env.
# A application-production.properties NEM töltődik prod profilon; kód nélkül kikapcsolás: false
EVENING_CLOSING_ARTIFACT_SUCCESS_ENABLED=true
