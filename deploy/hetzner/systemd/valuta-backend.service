[Unit]
Description=Valuta Backend Spring Boot Application
After=postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
Type=simple
User=valuta
WorkingDirectory=/opt/valutavalto/backend
EnvironmentFile=/opt/valutavalto/backend/.env
# TODO: replace hardcoded SNAPSHOT path with symlink
# Recommended: ln -sf /opt/valutavalto/backend/target/valuta-backend-<VERSION>.jar \
#              /opt/valutavalto/backend/target/valuta-backend-current.jar
# Then update ExecStart to use valuta-backend-current.jar
ExecStart=/usr/bin/java -jar /opt/valutavalto/backend/target/valuta-backend-1.0.0-SNAPSHOT.jar --server.port=8080
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
