[Unit]
Description=Valuta Backend Spring Boot Application
After=postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
Type=simple
User=valuta
WorkingDirectory=/opt/valutavalto/backend
EnvironmentFile=/opt/valutavalto/backend/.env
# Symlink managed by CI: deploy-hetzner.yml creates valuta-backend-current.jar -> valuta-backend-X.Y.Z.jar
# To update manually: ln -sf /opt/valutavalto/backend/target/valuta-backend-<VERSION>.jar \
#                          /opt/valutavalto/backend/target/valuta-backend-current.jar
ExecStart=/usr/bin/java -jar /opt/valutavalto/backend/target/valuta-backend-current.jar --server.port=8080
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
