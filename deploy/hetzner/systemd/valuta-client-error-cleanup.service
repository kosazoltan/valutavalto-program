[Unit]
Description=Valutavalto client_error_log retention cleanup
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
LogsDirectory=valutavalto
ExecStart=/opt/valutavalto/scripts/cleanup-client-error-log.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=valuta-client-error-cleanup
