docs/legacy-drive/

Anti/

Felmérés/
# ATTENTION: the next pattern is the macOS NFD-encoded variant of the same
# directory name. .gitignore matching is byte-exact (NOT Unicode-normalized),
# so BOTH NFC (precomposed) and NFD (decomposed) byte sequences must be present.
# DO NOT remove this entry, NOR let your editor / formatter auto-normalize it!
# NFC bytes:  46 65 6C 6D C3 A9 72 C3 A9 73 2F   (Linux/Windows default)
# NFD bytes:  46 65 6C 6D 65 CC 81 72 65 CC 81 73 2F   (macOS HFS+ default)
Felmérés/

# Nagy fájlok kizárása
*.m4a
.tmp_*.txt

# Runtime / test / local artifacts
penztar-client/.dev-app/
frontend-react/test-results/
frontend-react/e2e-relay-final-report.json
frontend-react/e2e-relay-results/
frontend-react/e2e-result.json

# Nagy binarisok — NEM commitolhatok (GitHub 100MB limit + 50MB figyelmeztetes).
# Ezek lokalis build-artefaktumok, a knowledge index / whisper modellek scripttel
# (re)generalhatok.
docs/valuta-knowledge.sqlite
tools/whisper-models/

# Python bytecode cache
__pycache__/
*.pyc
*.pyo
frontend-react/tsconfig.node.tsbuildinfo
frontend-react/tsconfig.tsbuildinfo
.vite/
backend_deployment/

# Installer build artifacts (nagy fájlok + secrets)
installer/build/
# Release artifact bundle (binary EXEs - csak GitHub Release-en publikalva)
dist/release/*.exe
dist/release/*.exe.sha256

# Environment backup/local files (may contain secrets)
*.env.backup
*.env.local-installer

tmp/

# OWASP Dependency-Check NVD cache (CI caches this between runs — do not commit)
backend/.owasp-dependency-check-data/

test-output.txt

frontend-react/dist/
penztar-client/dist/
penztar-client/dist-electron/
.worktrees/

configs/secrets.json
security-reports/
update_pw.sql
penztar-client/test-results/

penztar-client/release-thin/

# V145 seed regen source (JSON exports from internal HR xlsx) - privacy
installer/scripts/seed-data/*.json

# Monorepo root
node_modules/
packages/*/node_modules/
# NOTE: openapi.d.ts + openapi.json generated files ARE committed.
# CI cannot regenerate them (needs running backend + DB), so the snapshot is
# the source of truth. Regenerate locally with `npm run typegen` when backend
# OpenAPI spec changes, then commit.

# Claude Code helyi runtime fajlok
.claude/scheduled_tasks.lock
