<a:Requirement.Title>A zálogosítás anoním</a:Requirement.Title>
<a:Code>REQ_   1</a:Code>
<a:CreationDate>1663265175</a:CreationDate>
<a:Creator>szomb</a:Creator>
<a:ModificationDate>1663266773</a:ModificationDate>
