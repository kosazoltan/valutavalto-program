    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Supply-chain upgrade: 3.5.11 -> 4.1.0
             - CVE-2026-22731 (Spring Boot Actuator auth bypass) fixed in 3.5.12
             - CVE-2026-29145 (Tomcat 10.1.52 CLIENT_CERT) fixed by bundled Tomcat 10.1.53 in 4.1.0 -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    
    <groupId>com.puzzleir</groupId>
    <artifactId>valuta-backend</artifactId>
    <version>2.28.73</version>
    <name>Valutaváltó Backend</name>
    <description>Valutaváltó program Spring Boot backend</description>
    
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <!-- CVE-2026-41842/41850/41851 fix: Spring Framework 7.0.7 -> 7.0.8
             (same 7.0.x line; Spring Framework 7.0.8 was published as the security patch release). -->
        <spring-framework.version>7.0.8</spring-framework.version>
        <!-- CVE-2026-22746/22748/47838 fix: Spring Security 6.5.9 -> 6.5.11 -->
        <spring-security.version>6.5.11</spring-security.version>
        <!-- CVE-2026-54515 fix: Jackson 2 BOM 2.21.4 -> 2.21.5 -->
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <!-- CVE-2026-34478/34480/34481 fix: log4j explicit override 2.24.3 -> 2.25.4 -->
        <log4j2.version>2.25.4</log4j2.version>
        <!-- CVE-2026-33186 fix: force patched grpc-api over Google client transitive -->
        <grpc.version>1.83.1</grpc.version>
        <!-- AI review fix Codex P1 #263 (2026-04-29): a `<tomcat.version>10.1.54</tomcat.version>`
             override SB 3.5-re volt szükséges (CVE-2026-34483/34486/34487 fix), de SB 4.0.6
             Servlet 6.1 stack-et céloz, ami Tomcat 11.x. A 10.1.x override Servlet 6.0
             line-t kényszerítene, ami startup/linkage hibákat okozhat (rejtett risk, már
             gyakorlatban nem manifesztálódott a 04-29-i deploy-on, de eltávolítjuk a BOM
             default-ra ATM-cleanup és future-proof). A SB 4.0.6 BOM default Tomcat verzió
             a Servlet 6.1-kompat (11.0.x), és tartalmazza a 04-29-ig publikált CVE-fix-eket. -->
        <!-- <tomcat.version>10.1.54</tomcat.version> -->
        <!-- CVE-2026-42198 + CVE-2026-54291 fix: PostgreSQL JDBC -> 42.7.13 -->
        <postgresql.version>42.7.13</postgresql.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.4.2</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <pitest.version>1.25.8</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <cyclonedx.version>2.9.3</cyclonedx.version>
        <!-- CVE-2026-41293/43512/43515/41284/43513/42498/43514 + CVE-2026-53404/53434/
             55276/55955/55956/59083/59084 fix: Tomcat 11.0.22 -> 11.0.24.
             Azonos 11.0.x Servlet-6.1 line, security point-release. -->
        <tomcat.version>11.0.24</tomcat.version>
        <!-- CVE-2026-47691/45674/44249/50010/45416/45673 fix:
             netty 4.2.14 -> 4.2.15. Azonos 4.2.x minor (Lettuce/Redis-kliens transitive),
             csak biztonsagi patch — API-kompat. -->
        <netty.version>4.2.15.Final</netty.version>
        <!-- Surefire argLine — ures alapertelmezett, JDK 25 profil felulirja -->
    </properties>
    
    <dependencies>
        <!-- Spring Boot Starters -->
