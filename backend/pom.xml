        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>13.1.0</version>
        </dependency>
        
        <!-- Jsoup HTML Parser (Raiffeisen scraping) -->
