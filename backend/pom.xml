            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.9.1</version>
        </dependency>
        
        <!-- SpringDoc OpenAPI / Swagger UI - 2.8.17 marad (Spring Boot 3.5 kompat)
             A 3.0.x ag Spring Boot 4.0.5-ot huz be (Jackson 3.x = inkompat 3.5-tel),
