        </dependency>

        <!-- QR code generation (TOTP enrollment) a fentebbi com.google.zxing
             (core + javase 3.5.4) függőséget használja — duplikált deklaráció
             eltávolítva (Maven 'duplicate dependency' warning + future-compat). -->

        <!-- ===================================================================
             EBC belso log+audit modul (V234 + VVLogger + DiagnosticsController)
             Forras: vault/feedback/valutavalto-belso-log-audit-modul-tervezet-2026-05-18.md
             ================================================================ -->

        <!-- Strukturalt JSON log encoder a Logback-hoz -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- Micrometer Tracing - trace_id / span_id MDC-be propagal -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
    </dependencies>
    
    <build>
        <resources>
            <!-- Default classpath:resources tartalom -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- V234 belso log+audit modul: a shared-logging packages/-bol bevont
                 error-codes.yaml a classpath gyokere ala kerul (DiagnosticsService
                 a `classpath:error-codes.yaml`-bol olvassa). -->
            <resource>
                <directory>${project.basedir}/../packages/shared-logging</directory>
                <includes>
                    <include>error-codes.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo: teszt-lefedettség mérése. A `report` XML/HTML riportot a target/site/jacoco alá
                 írja; a CI diff-coverage gate (diff-cover) ebből a jacoco.xml-ből méri a PR-diff sorait.
                 NEM állítunk teljes-repo coverage-küszöböt (a legacy adósság nem blokkolhat) — a küszöb
                 kizárólag a MEGVÁLTOZOTT sorokra érvényes, a CI-ben (diff-cover). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- CycloneDX SBOM: a build a target/-be írja a bom.json + bom.xml szoftver-anyagjegyzéket
                 (supply-chain transzparencia, szabályozott/pénzügyi elvárás). A `package` fázishoz kötve. -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.version}</version>
                <executions>
                    <execution>
                        <id>cyclonedx-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputName>bom</outputName>
                    <outputFormat>all</outputFormat>
                    <projectType>application</projectType>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Security gate integration: make OWASP dependency scanning available in the build lifecycle. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.2.2</version>
                <configuration>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
                <executions>
                    <execution>
                        <id>security-dependency-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Surefire: a default `mvn test` futasa kihagyja a JUnit 5 `@Tag("performance")`
                annotaciot tartalmazo teszteket (pl. PerformanceTest, DailyClosingPerformanceTest).
                Aktivalas: `mvn -Pperf test` vagy `mvn -Dgroups=performance test`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>performance</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- JDK 25+ Mockito/ByteBuddy kompatibilitas — automatikus aktivalas -->
        <profile>
            <id>jdk25-mockito-fix</id>
            <activation>
                <jdk>[25,)</jdk>
            </activation>
            <properties>
                <argLine>-XX:+EnableDynamicAgentLoading -javaagent:${user.home}/.m2/repository/net/bytebuddy/byte-buddy-agent/1.17.8/byte-buddy-agent-1.17.8.jar</argLine>
            </properties>
        </profile>

        <!--
            `perf` profile: ujra-engedelyezi a performance-tagged teszteket
            (override-olja a default `excludedGroups`-ot).
            Hasznalat: `mvn -Pperf test` vagy `mvn -Pperf test -Dtest=DailyClosingPerformanceTest`
        -->
        <profile>
            <id>perf</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>performance</groups>
                            <excludedGroups></excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing (PIT). Csak explicit hívásra fut (NEM lassítja a normál buildet):
             `mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage` (a `test` goal felesleges —
             a PIT úgyis újrafuttatja a teszteket). A tesztek HATÉKONYSÁGÁT méri: szándékos hibákat (mutánsokat)
             injektál a cél-kódba, és ellenőrzi, elkapja-e egy teszt. A pénz-út kritikus service-eire szűkítve
             (targetClasses) — a teljes repo mutation-tesztje órákig futna és nem adna arányos értéket.
             Küszöb: mutationThreshold=60 (a kritikus pénz-úton a tesztnek a mutánsok többségét ölnie kell). -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>hu.puzzleir.valuta.service.DailyBalanceService</param>
                                <param>hu.puzzleir.valuta.service.CashBalanceService</param>
                                <param>hu.puzzleir.valuta.service.AverageRateReportService</param>
                            </targetClasses>
                            <targetTests>
                                <param>hu.puzzleir.valuta.service.DailyBalanceServiceTest</param>
                                <param>hu.puzzleir.valuta.service.CashBalanceServiceTest</param>
                                <param>hu.puzzleir.valuta.service.AverageRateReportServiceTest</param>
                            </targetTests>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <!-- mutationThreshold=60: a tesztek a mutánsok többségét (lefedettséggel együtt)
                                 öljék a kritikus pénz-úton. A NO_COVERAGE mutáns is számít — a lefedetlen
                                 pénz-út-kód valódi teszt-hiány, amit tesztírással zárunk, NEM küszöb-lazítással. -->
                            <mutationThreshold>60</mutationThreshold>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>


