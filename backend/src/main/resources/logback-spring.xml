<?xml version="1.0" encoding="UTF-8"?>
<!--
  EBC Valutavalto - Logback config + strukturalt JSON output.

  Forras: vault/feedback/valutavalto-belso-log-audit-modul-tervezet-2026-05-18.md (5.1)

  Ket profile:
    - dev/test: human-readable console (Spring Boot default)
    - prod: JSON-structured output a file-ra (/var/log/valuta-backend.log)
            + console (systemd journal-ban olvashato)

  PII redaktor: a `RedactingPatternConverter` (Logback custom converter)
  futtatja a `Redactor.redact(...)` regex-mintakat a uzeneten + a stack-en.
  Igy a jelszo/IBAN/JWT/Bearer/OpenAI-kulcs SOHA NEM keruil a log-fajlba.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- Audit-iter3 P1 (CodeQL java/log-injection defense-in-depth, 2026-04-27):
       a %replace(%msg){'[\r\n]', '_'} mar a application.properties-ben
       konfiguralt. Itt ezenfelul a 'redact' custom converter is fut. -->
  <conversionRule conversionWord="redact"
                  converterClass="hu.puzzleir.valuta.logging.RedactingPatternConverter"/>

  <!-- 1. PROD profile: JSON output + redactor -->
  <springProfile name="production,prod">

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"backend","service_version":"${APP_VERSION:-2.5.57}","env":"${SPRING_PROFILES_ACTIVE:-prod}"}</customFields>
        <includeMdc>true</includeMdc>
        <includeCallerData>false</includeCallerData>
        <fieldNames>
          <timestamp>ts</timestamp>
          <level>level</level>
          <thread>thread</thread>
          <logger>logger</logger>
          <message>message</message>
          <stackTrace>error.stack</stackTrace>
        </fieldNames>
        <!-- A redactor a JSON payload encode-olas ELOTT futtatja a regex-eket -->
        <jsonGeneratorDecorator class="net.logstash.logback.decorate.MaskingJsonGeneratorDecorator">
          <defaultMaskPattern>"((?:password|pwd|token|secret|apiKey|authorization|customer.name|idNumber|taxId|pan)\b[^,}]*?)"</defaultMaskPattern>
          <defaultMask>[REDACTED]</defaultMask>
        </jsonGeneratorDecorator>
      </encoder>
    </appender>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${LOG_PATH:-/var/log/valuta-backend}/valuta-backend.json.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${LOG_PATH:-/var/log/valuta-backend}/valuta-backend.json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>100MB</maxFileSize>
        <maxHistory>90</maxHistory>
        <totalSizeCap>10GB</totalSizeCap>
      </rollingPolicy>
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"backend","service_version":"${APP_VERSION:-2.5.57}","env":"${SPRING_PROFILES_ACTIVE:-prod}"}</customFields>
        <includeMdc>true</includeMdc>
        <fieldNames>
          <timestamp>ts</timestamp>
          <level>level</level>
          <message>message</message>
          <stackTrace>error.stack</stackTrace>
        </fieldNames>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="JSON_CONSOLE"/>
      <appender-ref ref="JSON_FILE"/>
    </root>
    <logger name="hu.puzzleir.valuta" level="DEBUG"/>
  </springProfile>

  <!-- 2. DEV / TEST profile: human-readable (a Spring Boot default config) -->
  <springProfile name="!production &amp; !prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="hu.puzzleir.valuta" level="DEBUG"/>
  </springProfile>

</configuration>
