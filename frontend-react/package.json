{
  "name": "valutavalto-frontend",
  "private": true,
  "version": "2.28.73",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:i18n-gate": "eslint src --rule \"{\\\"@typescript-eslint/no-explicit-any\\\":\\\"off\\\"}\" --max-warnings 2503",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "validate": "npm run lint && npm run type-check",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:rate-maker": "playwright test --config=playwright.rate-maker.config.ts",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'",
    "test:integration:prod": "vitest run src/pages/setup/SetupWizard.integration.test.ts --maxWorkers=1 --testTimeout=35000"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@react-oauth/google": "^0.13.5",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/sockjs-client": "^1.5.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "i18next": "^26.3.6",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.28.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.11",
    "eslint": "^10.8.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "react-router": "8.3.0"
  }
