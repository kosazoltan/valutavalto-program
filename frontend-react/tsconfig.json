{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@valuta/shared-api": [
        "../packages/shared-api/src/index.ts"
      ],
      "@valuta/shared-ipc": [
        "../packages/shared-ipc/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../packages/shared-api/src",
    "../packages/shared-ipc/src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}