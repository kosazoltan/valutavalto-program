# PLACEHOLDER template — a build-installer.ps1 generalja a `.env.production`-t.
# A `.env.production` fajl a `.gitignore`-ban van (Google Desktop OAuth secret miatt).

# A VITE_API_URL csak default — a runtime SQLite config `server_url` felulirja
# (a telepito wizard beirja). A localhost csak dev-time, production-ban SOHA.
VITE_API_URL=https://excvaluta.com/api/v1
VITE_DEFAULT_COMPANY_CODE=EBC
VITE_APP_VERSION=2.3.0

# Google OAuth Web client ID (browser fallback, ha a renderer mas kontextusban
# fut, pl. dev-mode `npm run dev`). Az Electron production-ban a Desktop OAuth
# client-et hasznalja az alabbi VITE_GOOGLE_DESKTOP_CLIENT_*-szel.
VITE_GOOGLE_CLIENT_ID=<<__GOOGLE_WEB_CLIENT_ID__>>

# Google OAuth Desktop client (Electron Authorization Code Flow + loopback redirect, RFC 8252).
# Project: ebc-valutavalto. Application type: Desktop app.
# A Desktop OAuth client_secret a Google docs szerint NEM titkos ("embedded in application binary"),
# PKCE veden a token exchange (RFC 7636). DE GitHub push protection blokkolja a kod-ba kerulest,
# ezert build-time injekcio a `.env` `GOOGLE_DESKTOP_CLIENT_ID/SECRET`-bol.
VITE_GOOGLE_DESKTOP_CLIENT_ID=<<__GOOGLE_DESKTOP_CLIENT_ID__>>
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=<<__GOOGLE_DESKTOP_CLIENT_SECRET__>>
