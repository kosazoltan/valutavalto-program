# Pénztár Kliens konfiguráció
# v2.1.6 production-first: alapertelmezesben a Hetzner production backend
# Lokalis fejlesztes eseten: VITE_API_URL=http://localhost:8080/api/v1
VITE_API_URL=https://excvaluta.com/api/v1
VITE_BRANCH_CODE=EBC
VITE_COMPANY_ID=1
VITE_COMPANY_CODE=EBC
VITE_ERRORLOG_HMAC_SECRET=

# Electron bootstrap auth (sync-engine initial login, csak offline SetupWizard-nal kell)
# Kitöltés kötelező offline módban, különben a sync 403-at kap és a cache üres marad!
PENZTAR_BOOTSTRAP_COMPANY_CODE=EBC
PENZTAR_BOOTSTRAP_WORKER_CODE=
PENZTAR_BOOTSTRAP_PASSWORD=
PENZTAR_BOOTSTRAP_ROLE_CODE=CASHIER

# ===========================================================================
# v2.5.25 CODE SIGNING (DigiCert KeyLocker + Sectigo OV) — SKELETON
# ===========================================================================
# Ha CODE_SIGN_ENABLED=1, az electron-builder a scripts/sign-with-keylocker.js
# hook-on keresztul a DigiCert KeyLocker cloud HSM-mel írja alá a Penztar.exe-t.
# Ha CODE_SIGN_ENABLED nincs / "0", a build ALAIRAS NELKUL fut (fejlesztoi build).
#
# Production buildhez kotelezo (ha cert mar megvan): CODE_SIGN_ENABLED=1 + a
# kovetkezo SM_* secrets a process env-ben:
CODE_SIGN_ENABLED=0
SM_HOST=https://clientauth.one.digicert.com
SM_API_KEY=
SM_CLIENT_CERT_FILE=
# CI alternativa: SM_CLIENT_CERT_FILE_B64=base64encoded.p12
SM_CLIENT_CERT_FILE_B64=
SM_CLIENT_CERT_PASSWORD=
SM_KEYPAIR_ALIAS=valuta-penztar-sign
SM_TIMESTAMP_SERVER=http://timestamp.digicert.com
