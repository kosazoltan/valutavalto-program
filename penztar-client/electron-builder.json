{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bestchange.penztar",
  "productName": "Valutavalto Penztar",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "node_modules/serialport/**/*",
    "node_modules/@serialport/**/*"
  ],
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "icon": "build/icons/app-icon-bestchange.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Penztar-Setup-${version}.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "language": "1038",
    "installerIcon": "build/icons/app-icon-bestchange.ico",
    "uninstallerIcon": "build/icons/app-icon-bestchange.ico",
    "installerHeader": "build/installer-header.png",
    "license": "LICENSE.txt",
    "include": "build/installer-cleanup.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "kosazoltan",
    "repo": "valutavalto-program"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "sql-wasm.wasm"
    },
    {
      "from": "../config/production-urls.json",
      "to": "production-urls.json"
    }
  ],
  "npmRebuild": false
}
