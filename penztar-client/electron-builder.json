{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bestchange.penztar",
  "productName": "Valutaváltó Pénztár",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "icon": "build/icons/app-icon-bestchange.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Penztar-Setup-${version}.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "language": "1038",
    "installerIcon": "build/icons/app-icon-bestchange.ico",
    "uninstallerIcon": "build/icons/app-icon-bestchange.ico",
    "installerHeader": "build/installer-header.png",
    "license": "LICENSE.txt"
  },
  "publish": {
    "provider": "github",
    "owner": "kosazoltan",
    "repo": "valutavalto-program"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "sql-wasm.wasm"
    },
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "node_modules/sql.js/dist/sql-wasm.wasm"
    },
    {
      "from": "node_modules/sql.js/dist/sql-wasm.js",
      "to": "node_modules/sql.js/dist/sql-wasm.js"
    },
    {
      "from": "node_modules/sql.js/package.json",
      "to": "node_modules/sql.js/package.json"
    }
  ]
}
