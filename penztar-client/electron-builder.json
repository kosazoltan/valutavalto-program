{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bestchange.penztar",
  "productName": "Valutavalto Penztar",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "asarUnpack": ["**/*.node", "node_modules/serialport/**/*", "node_modules/@serialport/**/*"],
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "!node_modules/sql.js/dist/sql-asm*.js",
    "!node_modules/sql.js/dist/worker.sql-asm*.js",
    "!node_modules/sql.js/dist/*-debug.js",
    "!node_modules/sql.js/dist/*-debug.wasm"
  ],
  "win": {
    "icon": "build/icons/app-icon-bestchange.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Penztar-Setup-${version}.exe",
    "signtoolOptions": {
      "sign": "scripts/sign-with-azure-keyvault.js",
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "publisherName": ["EXCLUSIVE BEST Change Zrt."]
    },
    "verifyUpdateCodeSignature": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true,
    "language": "1038",
    "installerIcon": "build/icons/app-icon-bestchange.ico",
    "uninstallerIcon": "build/icons/app-icon-bestchange.ico",
    "installerHeader": "build/installer-header.png",
    "license": "LICENSE.txt",
    "include": "build/installer-cleanup.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "kosazoltan",
    "repo": "valutavalto-program",
    "channel": "penztar"
  },
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "sql-wasm.wasm"
    },
    {
      "from": "../config/production-urls.json",
      "to": "production-urls.json"
    }
  ],
  "npmRebuild": false
}
