{
  "name": "valuta-penztar",
  "version": "2.28.96",
  "description": "Valutavalto Penztar Kliens - Electron",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c green,blue \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:main": "npx vite",
    "dev:renderer": "powershell -NoProfile -Command \"$env:VITE_PROXY_TARGET='https://excvaluta.com'; npm --prefix ../frontend-react run dev -- --host 0.0.0.0 --port 3000\"",
    "build:electron": "vite build",
    "build:frontend": "cd ../frontend-react && npm run build",
    "copy:frontend": "shx rm -rf dist && shx cp -r ../frontend-react/dist dist",
    "build": "npm run build:electron && npm run build:frontend && npm run copy:frontend",
    "package": "node ../scripts/check-four-area-alignment.mjs && npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "lint": "eslint electron vite.config.ts vitest.config.ts",
    "test": "vitest --config vitest.config.ts --run",
    "test:unit": "vitest --config vitest.config.ts --run --exclude '**/*.integration.test.ts'",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:list": "playwright test --config playwright.config.ts --list"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "shx": "^0.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "rimraf": "^5.0.10",
    "glob": "^13.0.6",
    "ip-address": ">=10.1.1",
    "js-yaml": "4.3.1",
    "shell-quote": "^1.10.0",
    "brace-expansion": "5.0.9"
  }
}
