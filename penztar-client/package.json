{
  "name": "valuta-penztar",
  "version": "1.1.0",
  "description": "Valutaváltó Pénztár Kliens - Electron (lokális backend)",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "vite build",
    "build:frontend": "cd ../frontend-react && npm run build",
    "copy:frontend": "shx rm -rf dist && shx cp -r ../frontend-react/dist dist",
    "build": "npm run build:frontend && npm run copy:frontend && npm run build:electron",
    "package": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "lint": "eslint electron vite.config.ts vitest.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/sql.js": "^1.4.9",
    "dotenv": "^17.3.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "shx": "^0.3.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^4.1.0"
  }
}
