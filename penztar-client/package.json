{
  "name": "valuta-penztar",
  "version": "1.6.0",
  "description": "Valutavalto Penztar Kliens - Electron",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c green,blue \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:main": "vite",
    "dev:renderer": "powershell -NoProfile -Command \"$env:VITE_PROXY_TARGET='https://excvaluta.com'; npm --prefix ../frontend-react run dev -- --host 127.0.0.1 --port 3000\"",
    "build:electron": "vite build",
    "build:frontend": "cd ../frontend-react && npm run build",
    "copy:frontend": "shx rm -rf dist && shx cp -r ../frontend-react/dist dist",
    "build": "npm run build:electron && npm run build:frontend && npm run copy:frontend",
    "package": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "lint": "eslint electron vite.config.ts vitest.config.ts",
    "test": "vitest --config vitest.config.ts --run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:list": "playwright test --config playwright.config.ts --list",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/sql.js": "^1.4.9",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "electron": "33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "shx": "^0.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^4.1.0"
  }
}
