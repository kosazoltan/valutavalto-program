# v2.3.0: penztar-client .env.production - az Electron build erre hagyatkozik
#
# A VITE_API_URL csak default — a runtime SQLite config server_url felulirja
# a telepito wizard beirja). A localhost csak dev-time, production-ban SOHA.

VITE_API_URL=https://excvaluta.com/api/v1
VITE_DEFAULT_COMPANY_CODE=EBC
VITE_APP_VERSION=2.3.0

# Google OAuth dolgozoi belepes (V178/V179, 2026-05-03).
# Web OAuth Client ID — ugyanaz mint a backend `google.client.id` es a frontend-react/.env.production-ban.
# Ures eseten a Google login gomb NEM jelenik meg az Electron Login oldalon.
# Client secret SOHA NEM kerulhet ide (Electron bundle reverse-engineerable).
VITE_GOOGLE_CLIENT_ID=819982945323-5tve3fr5a9cstso6o3db6p838lo2v6sn.apps.googleusercontent.com