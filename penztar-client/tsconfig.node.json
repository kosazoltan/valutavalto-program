{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "./dist-tsnode",
    "declaration": true
  },
  "include": ["vite.config.ts", "electron/**/*.ts"]
}
