# =============================================================================
# RENDER POSTGRESQL (Központi szerver)
# =============================================================================
# Render Dashboard → valuta-production → Info → Internal Database URL
RENDER_DB_URL=postgresql://valuta_user:YOUR_PASSWORD@dpg-xxxxx.frankfurt-postgres.render.com/valuta_production

# External URL (psql klienshez, helyi fejlesztéshez)
RENDER_DB_URL_EXTERNAL=postgresql://valuta_user:YOUR_PASSWORD@dpg-xxxxx.frankfurt-postgres.render.com:5432/valuta_production

# Spring Boot backend környezeti változó (RENDER_DB_URL másolata)
DATABASE_URL=${RENDER_DB_URL}

# =============================================================================
# SPRING BOOT BACKEND
# =============================================================================
# JWT token titkosítási kulcs (generálj erős random string-et!)
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# JWT token élettartam (másodperc)
JWT_EXPIRATION=86400

# Admin felhasználó kezdő jelszó (első indításkor)
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# Alkalmazás port
SERVER_PORT=8080

# NVD API kulcs az OWASP dependency-check gyors és stabil CVE lekérdezéseihez
NVD_API_KEY=

# =============================================================================
# GOOGLE OAUTH DOLGOZOI BELEPES (V178/V179, 2026-05-03)
# =============================================================================
# Web OAuth Client ID a Google Cloud Console "OAuth 2.0 Client IDs" lapjarol.
# Type: Web application. Authorized JavaScript origins:
#   https://excvaluta.com
#   https://www.excvaluta.com
#   http://localhost:3000  (csak fejlesztes)
#
# A backend (`google.client.id`) ES a frontend (VITE_GOOGLE_CLIENT_ID) UGYANAZT
# az ertekt hasznalja — ez a token audience-jenek validacio alapja.
#
# CSAK a client ID mehet ide. A client secret SOHA NEM kerulhet a frontendbe
# es NEM mehet ebbe a fajlba (popupos ID token loginhoz nem kell secret).
GOOGLE_CLIENT_ID=

# Google Workspace hosted domain whitelist (vesszovel elvalasztva, opcionalis).
# Pl. "puzzleir.hu,excvaluta.com" — csak a felsorolt domain-bol jovo Workspace
# accountokat fogadja el. Ures = nincs hd-restrikcio (gmail.com cimek a worker.email
# whitelist alapjan engedhetok).
GOOGLE_LOGIN_ALLOWED_DOMAINS=

# Elso sikeres Google login utan automatikusan kotni a Google `sub` claim-et a worker-hez?
# true (alapertelmezett) = igen — biztonsagos elso bind.
# false = adminnak elobb manualisan kell kotnie a workerhez.
GOOGLE_LOGIN_BIND_SUB_ON_FIRST_LOGIN=true

# (LEGACY) Gmail OAuth integraciohoz (NEM dolgozoi loginhoz). Marad a meglevo
# email-fiok callback flow-hoz.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://excvaluta.com/api/v1/email/accounts/callback

# =============================================================================
# CLOUDFLARE R2 (Archívum tárolás - később beállítandó)
# =============================================================================
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET_NAME=valuta-archive
R2_REGION=auto

# =============================================================================
# PÉNZTÁR GÉP - LOKÁLIS POSTGRESQL (Docker)
# =============================================================================
# Lokális PostgreSQL jelszó (pénztár gépen futó Docker konténer)
CASHIER_DB_PASSWORD=LOCAL_SECURE_PASSWORD

# Lokális PostgreSQL port (5433 hogy ne ütközzön a Render-rel)
CASHIER_DB_PORT=5433

# USB backup meghajtó betűjel (Windows: E:, F:, stb.)
USB_BACKUP_DRIVE=E:

# BitLocker USB jelszó (területi vezető állítja be)
USB_BITLOCKER_PASSWORD=SET_BY_REGIONAL_MANAGER

# =============================================================================
# REPLIKÁCIÓ
# =============================================================================
# Render PostgreSQL replication user (külön user jogosultságokkal)
REPLICATION_USER=replication_user
REPLICATION_PASSWORD=SECURE_REPLICATION_PASSWORD

# Szinkronizálás gyakoriság (másodperc)
SYNC_INTERVAL_SECONDS=300

# Batch size (hány tranzakció után szinkronizál azonnal)
SYNC_BATCH_SIZE=10

# =============================================================================
# EMAIL KONFIGURÁCIÓ (opcionális - jelszó emlékeztető)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@valuta.hu

# =============================================================================
# MONITORING / LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/application.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=30

# =============================================================================
# MANDATORY DB PREFLIGHT (scripts/security/mandatory-db-preflight.ps1 + security gate)
# =============================================================================
# Lokális URL (jdbc vagy postgresql://) — ha üres, LOCAL_DB_HOST / NAME / USER / PASSWORD
# LOCAL_DATABASE_URL=jdbc:postgresql://localhost:5432/valuta
#
# Távoli (Neon / Render): NEON_DATABASE_URL vagy RENDER_DB_URL_EXTERNAL vagy nem-localhost DATABASE_URL
#
# Ha a távoli DB elérhető, de még nincs Flyway tábla (üres séma), a gate elhasalna.
# Fejlesztői gépen ideiglenesen:
# DB_PREFLIGHT_REMOTE_MODE=optional
#
# Éles CI / migrált távoli DB: ne állítsd (alap = strict), vagy explicit:
# DB_PREFLIGHT_REMOTE_MODE=strict
