{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bestchange.arfolyamkeszito",
  "productName": "Valutavalto Arfolyamkeszito",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!node_modules/sql.js/dist/sql-asm*.js",
    "!node_modules/sql.js/dist/worker.sql-asm*.js",
    "!node_modules/sql.js/dist/*-debug.js",
    "!node_modules/sql.js/dist/*-debug.wasm"
  ],
  "win": {
    "icon": "../penztar-client/build/icons/app-icon-bestchange.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Arfolyamkeszito-Setup-${version}.exe",
    "signtoolOptions": {
      "sign": "scripts/sign-with-azure-keyvault.js",
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "verifyUpdateCodeSignature": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "language": "1038",
    "installerIcon": "../penztar-client/build/icons/app-icon-bestchange.ico",
    "uninstallerIcon": "../penztar-client/build/icons/app-icon-bestchange.ico",
    "installerHeader": "../penztar-client/build/installer-header.png"
  },
  "extraResources": [
    {
      "from": "../config/production-urls.json",
      "to": "production-urls.json"
    }
  ],
  "npmRebuild": false
}
